# --- Bazaar runtime -------------------------------------------------------
# fake | openai | anthropic   (fake = deterministic, offline; used by tests and CI)
BAZAAR_LLM=fake                            # fake | openai | groq | anthropic
OPENAI_API_KEY=
BAZAAR_OPENAI_MODEL=gpt-4o
GROQ_API_KEY=                              # free real-model backend (console.groq.com); BAZAAR_LLM=groq
BAZAAR_GROQ_MODEL=openai/gpt-oss-120b
BAZAAR_OPENAI_MODEL_COMPILE=gpt-4o-mini   # catalog normalisation/enrichment (high volume)
BAZAAR_LLM_CACHE=true                      # data/runtime/llm_cache.sqlite: repeat calls are free
BAZAAR_LLM_WORKERS=8
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
BAZAAR_MODEL=claude-sonnet-4-5

# fake | razorpay    (fake = in-memory sandbox; razorpay = test-mode keys below)
BAZAAR_RAZORPAY=fake
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gateway
BAZAAR_BASE_URL=http://localhost:8000
BAZAAR_DB_URL=sqlite:///data/runtime/bazaar.db
BAZAAR_API_VERSION=2026-08-28
BAZAAR_ADMIN_TOKEN=dev-admin-token
BAZAAR_ENV=dev                             # prod = refuse to start on the dev admin token / webhook secret
