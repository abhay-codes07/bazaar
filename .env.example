# --- Bazaar runtime -------------------------------------------------------
# fake | anthropic   (fake = deterministic, offline; used by tests and CI)
BAZAAR_LLM=fake
ANTHROPIC_API_KEY=
BAZAAR_MODEL=claude-sonnet-4-5

# fake | razorpay    (fake = in-memory sandbox; razorpay = test-mode keys below)
BAZAAR_RAZORPAY=fake
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gateway
BAZAAR_BASE_URL=http://localhost:8000
BAZAAR_DB_URL=sqlite:///data/runtime/bazaar.db
BAZAAR_API_VERSION=2026-08-28
BAZAAR_ADMIN_TOKEN=dev-admin-token
